  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@fastify/jwt": "^8.0.1",
    "@prisma/client": "^5.19.1",
    "csv-parse": "^5.5.6",
    "fastify": "^4.28.1",
    "nanoid": "^3.3.7",
    "prisma": "^5.19.1",
    "typescript": "^5.5.4",
    "@types/node": "^20.14.15",
    "tsx": "^4.16.5"
  }
}
