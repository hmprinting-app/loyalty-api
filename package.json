{
  "name": "loyalty-api",
  "version": "1.0.0",
  "private": true,
  "description": "HM Printing VIP Club - backend loyalty program",
  "scripts": {
    "build": "prisma generate && tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
