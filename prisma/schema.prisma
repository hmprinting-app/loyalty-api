generator client {
  provider = "prisma-client-js"
}
datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Tier {
  BRONZE_PAPER // LEGACY — dipertahankan biar data lama nggak error, sudah tidak dipakai untuk member baru
  SILVER_IVORY // LEGACY — setara GOLD baru (range sama: 5.000-14.999), dipertahankan untuk histori
  GOLD_FOIL // LEGACY — setara PLATINUM baru (range sama: 15.000+), dipertahankan untuk histori

  // 4 Level tier aktif (dihitung dari lifetimePoints)
  SOBAT // 0 - 999      (Craft Paper)   — maks potong nota 15%   — komisi referral: flat 100 poin
  SILVER // 1.000 - 4.999 (Silver Ivory)  — maks potong nota 25%   — komisi referral: 1% nilai transaksi teman
  GOLD // 5.000 - 14.999 (Gold Foil)    — maks potong nota 40%   — komisi referral: 1.5% nilai transaksi teman
  PLATINUM // 15.000+       (Platinum Emboss) — maks potong nota 100%  — komisi referral: 2% nilai transaksi teman
}

enum ProductCategory {
  HM_BOOKS_PRINTING // Buku Custom, Buku Tahunan, Notebook, Yasin, Undangan, ID Card
  PACKAGING
  PROMOSI_LAINNYA // Banner, Nota NCR, Stiker, dll — tetap pakai kalkulator lama (material dropdown)
}

// ============================================================================
// BARU — Katalog produk config-driven (Poin 1: UI Variant Selector Shopee-style).
//
// Kenapa variantGroups & priceConfig disimpan sebagai JSON (bukan tabel
// terpisah per opsi)? Supaya Bos CH bisa nambah/ubah pilihan ukuran, halaman,
// cover, atau harga TANPA perlu migration database tiap kali — cukup lewat
// endpoint admin (lihat routes/admin.ts).
//
// Struktur variantGroups (array, urutan = urutan tampil chip di UI):
//   {
//     key: "size",              // dipakai sebagai key di object `selection`
//     label: "Ukuran",          // label yang tampil di UI
//     kind: "multiplier" | "pageBracket" | "quantity",
//     options: [ { value: "A5", label: "A5" }, ... ]
//   }
//   - kind "multiplier": harga dikali faktor dari priceConfig.factors[key][value]
//   - kind "pageBracket": harga ditambah nominal dari priceConfig.pageBracketAdd[value]
//   - kind "quantity": WAJIB PERSIS SATU per produk, chip preset qty + opsi
//     "custom" yang munculin input angka manual. Dipakai buat hitung diskon
//     grosir dari priceConfig.quantityBreaks.
//
// Struktur priceConfig:
//   {
//     baseUnitPrice: number,               // harga dasar per pcs (kombinasi termurah)
//     factors: { [groupKey]: { [value]: number } },      // untuk kind "multiplier"
//     pageBracketAdd: { [groupKey]: { [value]: number } }, // untuk kind "pageBracket"
//     quantityBreaks: [ { minQty: number, discountPercent: number } ] // urut naik
//   }
//
// CATATAN PENTING: semua ANGKA di seeder (lihat
// POST /api/admin/maintenance/seed-books-printing-catalog) adalah CONTOH/
// PLACEHOLDER supaya sistemnya bisa langsung dites end-to-end. Bos CH WAJIB
// ganti ke harga riil lewat POST /api/admin/products/:slug sebelum dipakai
// customer beneran.
// ============================================================================
model Product {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  category      ProductCategory
  badge         String?
  description   String?
  image         String?
  unit          String          @default("pcs") // pcs | buku | lbr | m² | dst
  variantGroups Json // lihat struktur di atas
  priceConfig   Json // lihat struktur di atas
  active        Boolean         @default(true)
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([category])
}

enum TxType {
  EARN_MANUAL
  EARN_AUTO_KANBAN // dipakai nanti pas integrasi sistem produksi aktif
  EARN_WELCOME
  EARN_TRANSITION
  EARN_REFERRAL // bonus utk referrer saat referral-nya order pertama
  REDEEM_VOUCHER
  REDEEM_NOTA // potong nota pakai poin saat checkout
  REDEEM_CASHOUT // poin referral dicairkan ke bank/e-wallet
  ADJUSTMENT
}

// Status produksi order teman yang direferensikan. Dipakai sebagai salah satu
// dari 2 syarat "gembok" cashout (harus COMPLETED).
enum OrderFulfillmentStatus {
  PENDING
  IN_PRODUCTION
  COMPLETED
  CANCELLED
}

// Status pembayaran order teman yang direferensikan. Dipakai sebagai syarat
// ke-2 "gembok" cashout (harus PAID). Dipisah dari fulfillment karena di
// dunia nyata percetakan, order bisa selesai produksi duluan sebelum lunas
// (termin/DP), atau lunas duluan sebelum produksi selesai.
enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
}

model Member {
  id                  String    @id @default(cuid())
  phone               String    @unique // format 628xxxxxxxxxx
  name                String
  magicToken          String    @unique @default(cuid())
  tier                Tier      @default(BRONZE_PAPER)
  spendablePoints     Int       @default(0)
  lifetimePoints      Int       @default(0)
  welcomeBonusClaimed Boolean   @default(false)
  lastLoginAt         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  // BARU — foto profil customer asli (link Cloudflare Images/Drive/dsb),
  // dipasang admin manual saat daftarin member. Nullable: kalau kosong,
  // PWA otomatis tampilin avatar inisial nama sebagai fallback (bukan
  // foto stok generic yang tidak related sama membernya).
  photoUrl String?

  // --- REFERRAL PROGRAM ---
  // referralCode dibuat nullable+unique: member lama akan NULL sampai script
  // backfill dijalankan (lihat POST /api/admin/maintenance/backfill-tier-referral).
  // Member baru SELALU dikasih kode otomatis saat dibuat (lihat routes/admin.ts).
  referralCode          String? @unique
  referralPointsBalance Int     @default(0) // TOTAL poin referral yang pernah didapat (termasuk yang masih terkunci)
  // BARU — bagian dari referralPointsBalance yang MASIH TERKUNCI karena order
  // teman terkait belum berstatus COMPLETED & PAID. Poin ini tetap kelihatan
  // di saldo & tetap bisa dipakai buat potong nota/voucher seperti biasa,
  // TAPI TIDAK BOLEH ikut diajukan Request Cashout sampai gemboknya lepas.
  // Formula "siap cair" = referralPointsBalance - referralPointsLocked.
  referralPointsLocked Int      @default(0)
  referredById          String?
  referredBy            Member? @relation("Referrals", fields: [referredById], references: [id])
  referrals             Member[] @relation("Referrals")

  transactions               PointsTransaction[]
  redemptions                Redemption[]
  cashoutRequests            CashoutRequest[]
  cloudFiles                 CloudFile[]
  referralConversionsAsReferrer ReferralConversion[] @relation("ReferrerConversions")
  referralConversionAsReferred  ReferralConversion?  @relation("ReferredConversion")

  @@index([magicToken])
  @@index([referredById])
}

model PointsTransaction {
  id             String   @id @default(cuid())
  memberId       String
  member         Member   @relation(fields: [memberId], references: [id])
  type           TxType
  spendableDelta Int // bisa negatif (saat redeem)
  lifetimeDelta  Int // 0 saat redeem, poin history tetap
  note           String?
  refOrderId     String? // buat nyambung ke order Kanban nanti
  createdBy      String // "system" atau nama admin
  createdAt      DateTime @default(now())

  @@index([memberId])
}

model Voucher {
  id          String       @id @default(cuid())
  title       String
  costPoints  Int
  stock       Int
  minSpend    String?
  code        String
  tierMin     Tier? // null = semua tier boleh tukar
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now())
  redemptions Redemption[]
}

model Redemption {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id])
  voucherId   String
  voucher     Voucher  @relation(fields: [voucherId], references: [id])
  pointsSpent Int
  redeemCode  String   @unique // ditunjukin admin/kasir saat customer klaim
  status      String   @default("pending") // pending | used | expired
  redeemedAt  DateTime @default(now())

  @@index([memberId])
}

// Request pencairan poin referral ke bank/e-wallet. Diproses manual oleh admin
// (approve/reject) sesuai skala solo-operator saat ini — lihat routes/admin.ts.
model CashoutRequest {
  id              String    @id @default(cuid())
  memberId        String
  member          Member    @relation(fields: [memberId], references: [id])
  pointsRequested Int
  amountRupiah    Int
  bankName        String?
  accountNumber   String?
  accountName     String?
  ewalletType     String?
  status          String    @default("pending") // pending | approved | rejected | paid
  adminNote       String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@index([memberId])
}

// "Cloud Storage Preview" — cuma nyimpen metadata + link (Google Drive/S3/dll),
// bukan hosting file itu sendiri. Admin input record ini tiap selesai garap
// desain master / proof cetak customer.
model CloudFile {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id])
  fileName  String
  fileUrl   String
  category  String   @default("Lainnya") // Desain Master | Proof Cetak | Invoice | Lainnya
  note      String?
  createdAt DateTime @default(now())

  @@index([memberId])
}

// ============================================================================
// BARU — Audit trail 1 baris per SATU order pertama teman yang direferensikan.
// Ini yang jadi "sumber kebenaran" buat:
//   1) Skema komisi tiering (berapa % / berapa poin flat yang dipakai, dan
//      tier referrer PADA SAAT itu — supaya histori tidak berubah kalau
//      tier referrer naik/turun belakangan)
//   2) Gembok cashout: poin dari conversion ini baru "siap cair" begitu
//      orderFulfillmentStatus = COMPLETED DAN orderPaymentStatus = PAID
//      (lihat updateReferralConversionStatus di src/lib/points.ts)
// ============================================================================
model ReferralConversion {
  id                     String                 @id @default(cuid())
  referrerId             String
  referrer               Member                 @relation("ReferrerConversions", fields: [referrerId], references: [id])
  referredMemberId       String                 @unique // 1 conversion per teman (order pertama saja)
  referredMember         Member                 @relation("ReferredConversion", fields: [referredMemberId], references: [id])
  orderAmountRupiah      Int
  referrerTierAtEarn     Tier // snapshot tier referrer saat komisi dihitung
  commissionPercent      Float? // null kalau pakai flat (tier SOBAT), diisi 0.01/0.015/0.02 untuk tier lain
  pointsAwarded          Int // hasil akhir poin yang dikreditkan (flat atau dari %)
  tierRecognized         Boolean                @default(true) // false = tier tidak dikenali, fallback flat SOBAT dipakai
  orderFulfillmentStatus OrderFulfillmentStatus @default(PENDING)
  orderPaymentStatus     OrderPaymentStatus     @default(UNPAID)
  refOrderId             String? // id order dari sistem Kanban, kalau ada
  pointsUnlockedAt       DateTime? // diisi otomatis begitu status jadi COMPLETED & PAID
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt

  @@index([referrerId])
  @@index([orderFulfillmentStatus, orderPaymentStatus])
}
