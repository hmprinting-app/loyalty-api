# Diisi otomatis oleh Railway kalau pakai Postgres plugin mereka
DATABASE_URL="postgresql://user:password@host:5432/loyalty"

# Ganti dengan string acak panjang, jangan dipakai bareng service lain
JWT_SECRET="change-me-super-secret-random-string"

# Dipakai admin panel/script bulk-import buat autentikasi (header x-admin-secret)
ADMIN_SECRET="change-me-admin-key"

# Domain frontend PWA yang boleh akses API ini (CORS)
CORS_ORIGIN="https://vip.hmprinting.id"

# Poin welcome bonus buat 3000+ kontak lama pas pertama kali login
WELCOME_BONUS_POINTS=500

PORT=3000
